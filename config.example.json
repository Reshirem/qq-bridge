{
  "qqBackend": "native",
  "dsh": {
    "baseUrl": "http://127.0.0.1:3080",
    "autoDetectPort": true,
    "provider": "deepseek-official",
    "model": "deepseek-flash",
    "reasoningEffort": "max",
    "authToken": "",
    "authHeader": "authorization",
    "authPrefix": "Bearer",
    "allowRemote": false
  },
  "desktopAgent": {
    "promptTemplates": {
      "roleCard": "【当前角色卡：{roleName}】\n{roleContent}",
      "qqAttention": "【QQ 提醒】\n{sources}",
      "qqSource": "- {key}{messageId}{count}",
      "restExpired": "【休息结束】休息时间到了。先留意当前情况，再按自己的兴趣和判断决定下一步。",
      "qqWake": "",
      "recovery": "【状态恢复检查】桥接需要重新确认会话状态。先查看当前会话和已有操作，避免重复已完成的事，再按当前情况继续。",
      "memoryBootstrap": "【长期记忆摘要｜来源为自身经历；用于延续经历与未完成事项，仍需按当前上下文判断】\n{entries}"
    }
  },
  "snowluma": {
    "wsUrl": "ws://127.0.0.1:3001",
    "httpUrl": "http://127.0.0.1:3000",
    "accessToken": "",
    "followDiscoveredEndpoint": true,
    "silenceWarnMs": 600000,
    "launcherPath": "",
    "homeDir": ""
  },
  "ownerQQ": null,
  "allow": {
    "private": [],
    "groups": []
  },
  "deny": {
    "private": [],
    "groups": []
  },
  "allowAllWhenEmpty": false,
  "consolePort": 3100,
  "consoleToken": "",
  "memory": {
    "enabled": false,
    "baseUrl": "http://127.0.0.1:8080",
    "namespace": "qq-bridge",
    "apiKey": "",
    "timeoutMs": 45000,
    "bootstrapLimit": 6,
    "bootstrapMaxChars": 2500
  },
  "memoryOrganizer": {
    "enabled": true,
    "timeZone": "Asia/Shanghai",
    "cliPath": ""
  },
  "chatLearning": {
    "enabled": true,
    "slang": true,
    "stickers": true,
    "minMessages": 20,
    "batchSize": 30,
    "cooldownMs": 300000,
    "maxWaitMs": 900000,
    "maxImages": 3,
    "sources": []
  },
  "socialV2": {
    "enabled": true,
    "attentionKeywords": [],
    "send": { "delayPerCharMs": 20 },
    "sticker": {
      "regularEnabled": true,
      "marketEnabled": true,
      "syncEnabled": true,
      "syncTtlMs": 60000,
      "maxListCount": 100,
      "collect": {
        "enabled": true,
        "maxPerMinute": 2,
        "maxPerHour": 10
      }
    },
    "feedback": {
      "maxLength": 500
    },
    "media": {
      "prefetchOnReceive": true,
      "maxBytes": 8388608,
      "maxPixels": 64000000,
      "maxCount": 5,
      "normalize": true,
      "maxModelBytes": 1048576,
      "maxLongEdge": 1280,
      "gifFrames": 6,
      "gifTile": 240,
      "normalizeTimeoutMs": 25000
    }
  },
  "webSearch": {
    "provider": "auto",
    "apiKey": "",
    "apiKeyEnv": "DEEPSEEK_API_KEY",
    "baseURL": "",
    "model": "deepseek-v4-flash",
    "maxUses": 5,
    "maxTokens": 4096,
    "maxResults": 8,
    "timeoutMs": 35000
  }
}
