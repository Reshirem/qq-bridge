{
  "dsh": {
    "baseUrl": "http://127.0.0.1:3080",
    "autoDetectPort": true,
    "provider": "deepseek-official",
    "model": "deepseek-flash",
    "reasoningEffort": "max",
    "authToken": "",
    "authHeader": "authorization",
    "authPrefix": "Bearer",
    "allowRemote": false
  },
  "desktopAgent": {
    "rest": {
      "defaultMs": 1800000,
      "maxMs": 14400000
    },
    "sleepSchedule": {
      "enabled": false,
      "sleepTime": "",
      "wakeTime": ""
    },
    "promptTemplates": {
      "roleCard": "【当前角色卡：{roleName}】\n{roleContent}",
      "qqAttention": "【QQ 提醒】\n{sources}",
      "qqSource": "- {key}{senderId}{messageId}{count}",
      "restExpired": "【自由活动时间{unreadSummary}】",
      "qqWake": "",
      "recovery": "【状态恢复检查】请结合当前上下文继续，避免重复已完成的操作。",
      "missingRest": "【回合收尾提醒】上一轮已结束但尚未收到 agent_rest。若当前已无待处理事项，请直接静默调用 agent_rest（勿重复已完成操作，勿输出挂机旁白）；若仍有未完事项则处理完后再调用。",
      "memoryBootstrap": "【长期记忆摘要｜来源为自身经历；用于延续经历与未完成事项，仍需按当前上下文判断】\n{entries}"
    }
  },
  "ownerQQ": null,
  "allow": {
    "private": [],
    "groups": []
  },
  "deny": {
    "private": [],
    "groups": []
  },
  "allowAllWhenEmpty": false,
  "consolePort": 3100,
  "consoleToken": "",
  "memory": {
    "enabled": false,
    "baseUrl": "http://127.0.0.1:8080",
    "namespace": "qq-bridge",
    "apiKey": "",
    "timeoutMs": 45000,
    "bootstrapLimit": 6,
    "bootstrapMaxChars": 2500
  },
  "memoryCurator": { "enabled": true },
  "memoryOrganizer": {
    "enabled": true,
    "timeZone": "Asia/Shanghai",
    "cliPath": ""
  },
  "chatLearning": {
    "enabled": true,
    "slang": true,
    "stickers": true,
    "minMessages": 20,
    "batchSize": 30,
    "cooldownMs": 300000,
    "maxWaitMs": 900000,
    "maxImages": 3,
    "sources": []
  },
  "socialV2": {
    "enabled": true,
    "attentionKeywords": [],
    "reminders": { "private": true, "atMention": true, "reply": true, "roleCardName": true, "keyword": true, "poke": true, "groupFollowup": true, "groupActivity": true, "unreadFollowup": true },
    "groupAttention": {
      "hotWindowMs": 240000,
      "hotDebounceMs": 5000,
      "hotExtendMs": 3000,
      "hotMaxDebounceMs": 10000,
      "privateActiveMs": 180000,
      "coldAggregateMs": 60000,
      "coldCooldownMs": 1200000
    },
    "send": { "delayPerCharMs": 20 },
    "sticker": {
      "regularEnabled": true,
      "marketEnabled": true,
      "syncEnabled": true,
      "syncTtlMs": 60000,
      "maxListCount": 100,
      "collect": {
        "enabled": true,
        "maxPerMinute": 2,
        "maxPerHour": 10
      }
    },
    "feedback": {
      "maxLength": 500
    },
    "media": {
      "prefetchOnReceive": true,
      "maxBytes": 8388608,
      "maxPixels": 64000000,
      "maxCount": 5,
      "maxVideoBytes": 52428800,
      "videoFrames": 9,
      "videoTile": 360,
      "normalize": true,
      "maxModelBytes": 1048576,
      "maxLongEdge": 1280,
      "gifFrames": 6,
      "gifTile": 240,
      "normalizeTimeoutMs": 25000
    }
  },
  "webSearch": {
    "provider": "auto",
    "apiKey": "",
    "apiKeyEnv": "DEEPSEEK_API_KEY",
    "baseURL": "",
    "model": "deepseek-v4-flash",
    "maxUses": 5,
    "maxTokens": 4096,
    "maxResults": 8,
    "timeoutMs": 35000
