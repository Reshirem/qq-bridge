{
  "dsh": {
    "baseUrl": "http://127.0.0.1:3080",
    "autoDetectPort": true,
    "provider": "deepseek-official",
    "model": "deepseek-flash",
    "reasoningEffort": "max",
    "authToken": "",
    "authHeader": "authorization",
    "authPrefix": "Bearer",
    "allowRemote": false
  },
  "desktopAgent": {
    "promptTemplates": {
      "roleCard": "【当前角色卡：{roleName}】\n{roleContent}",
      "qqAttention": "【QQ 提醒】\n有以下 QQ 来源触发了提醒。这里只附来源信息，不含消息正文；你可以结合正在做的事，决定是否查看、回应或稍后再看。\n{sources}",
      "qqSource": "- {key}（{kind}，提醒原因：{reason}，发送者：{sender}{senderId}{messageId}{count}）",
      "restExpired": "【休息结束】休息时间到了。先留意当前情况，再按自己的兴趣和判断决定下一步。",
      "qqWake": "【休息被 QQ 提醒提前结束】",
      "recovery": "【状态恢复检查】桥接需要重新确认会话状态。先查看当前会话和已有操作，避免重复已完成的事，再按当前情况继续。",
      "memoryBootstrap": "【长期记忆摘要｜来源为自身经历；用于延续经历与未完成事项，仍需按当前上下文判断】\n{entries}"
    }
  },
  "snowluma": {
    "wsUrl": "ws://127.0.0.1:3001",
    "httpUrl": "http://127.0.0.1:3000",
    "accessToken": "",
    "followDiscoveredEndpoint": true,
    "silenceWarnMs": 600000,
    "launcherPath": "",
    "homeDir": ""
  },
  "ownerQQ": null,
  "allow": {
    "private": [],
    "groups": []
  },
  "deny": {
    "private": [],
    "groups": []
  },
  "allowAllWhenEmpty": false,
  "sendDelayMs": 300,
  "consolePort": 3100,
  "consoleToken": "",
  "memory": {
    "enabled": false,
    "baseUrl": "http://127.0.0.1:8080",
    "namespace": "qq-bridge",
    "apiKey": "",
    "timeoutMs": 45000,
    "bootstrapLimit": 6,
    "bootstrapMaxChars": 2500
  },
  "pricing": {
    "models": {
      "my-relay-model": {
        "label": "我的中转模型",
        "off": {
          "cacheHit": 0.5,
          "cacheMiss": 3,
          "output": 9
        }
      }
    }
  },
  "security": {
    "interceptNotify": true
  },
  "socialV2": {
    "enabled": true,
    "attentionKeywords": [],
    "send": {
      "burstEnabled": true,
      "burstMaxMessages": 8,
      "burstIntervalMinMs": 1000,
      "burstIntervalMaxMs": 3000,
      "longGapProbability": 0.2,
      "longGapMinMs": 5000,
      "longGapMaxMs": 10000,
      "maxSendPerMinute": 8,
      "maxSendPerHour": 60,
      "maxMessageChars": 500,
      "maxGapMs": 10000,
      "gapBaseMs": 800,
      "gapPerCharMs": 20,
      "recommendedHint": "单条消息不要用空格断句，中文短句用逗号/顿号或直接连写；分条时每条都要读起来完整，不要把同一句话拆到两条里；普通闲聊建议一次 1~3 条，条间 1~3 秒；讲故事/回忆可以 5~10 秒间隔；不要连续刷屏。"
    },
    "wait": {
      "defaultMs": 30000,
      "minMs": 5000,
      "maxMs": 600000,
      "defaultQuietMs": 8000,
      "minQuietAfterNewMs": 10000
    },
    "sticker": {
      "enabled": true,
      "syncTtlMs": 60000,
      "maxListCount": 100,
      "collect": {
        "enabled": true,
        "maxPerMinute": 2,
        "maxPerHour": 10
      }
    },
    "feedback": {
      "maxLength": 500,
      "notifyOwnerOnError": false
    },
    "context": {
      "recentLimit": 100,
      "unreadLimit": 30,
      "contextWindow": 20
    },
    "media": {
      "maxBytes": 8388608,
      "maxPixels": 64000000,
      "maxCount": 5,
      "normalize": true,
      "maxModelBytes": 1048576,
      "maxLongEdge": 1280,
      "gifFrames": 6,
      "gifTile": 240,
      "normalizeTimeoutMs": 25000
    }
  },
  "webSearch": {
    "provider": "auto",
    "apiKey": "",
    "apiKeyEnv": "DEEPSEEK_API_KEY",
    "baseURL": "",
    "model": "deepseek-v4-flash",
    "maxUses": 5,
    "maxTokens": 4096,
    "maxResults": 8,
    "timeoutMs": 35000
